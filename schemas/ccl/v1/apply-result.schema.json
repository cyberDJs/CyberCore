{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cybercore://schemas/ccl/v1/apply-result",
  "title": "CyberCore Apply Result",
  "allOf": [
    { "$ref": "common-record.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "apply_result" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "plan_revision", "approval_id", "executor_id", "started_at", "status", "step_results"],
          "properties": {
            "plan_id": { "type": "string" },
            "plan_revision": { "type": "integer", "minimum": 1 },
            "approval_id": { "type": "string" },
            "executor_id": { "type": "string" },
            "provider_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "started_at": { "type": "string", "format": "date-time" },
            "completed_at": { "type": ["string", "null"], "format": "date-time" },
            "step_results": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["step_id", "status", "started_at"],
                "properties": {
                  "step_id": { "type": "string" },
                  "status": { "enum": ["succeeded", "failed", "skipped", "cancelled"] },
                  "started_at": { "type": "string", "format": "date-time" },
                  "completed_at": { "type": ["string", "null"], "format": "date-time" },
                  "message": { "type": ["string", "null"] },
                  "receipt_reference": { "type": ["string", "null"] }
                }
              }
            },
            "provider_receipts": { "type": "array", "items": { "type": "string" } },
            "recovery": { "type": ["object", "null"] },
            "status": { "enum": ["succeeded", "partially_succeeded", "failed", "cancelled"] }
          }
        }
      }
    }
  ]
}