{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cybercore://schemas/ccl/v1/verification",
  "title": "CyberCore Verification",
  "allOf": [
    { "$ref": "common-record.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "verification" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "apply_result_id", "observation_ids", "evidence_ids", "expected_effects", "actual_effects", "status"],
          "properties": {
            "plan_id": { "type": "string" },
            "apply_result_id": { "type": "string" },
            "observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "expected_effects": { "type": "array", "minItems": 1, "items": { "type": "object" } },
            "actual_effects": { "type": "array", "items": { "type": "object" } },
            "mismatches": { "type": "array", "items": { "type": "object" } },
            "verified_at": { "type": "string", "format": "date-time" },
            "status": { "enum": ["verified", "mismatch", "inconclusive", "failed"] }
          }
        }
      }
    }
  ]
}