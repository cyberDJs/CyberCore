// Managed by CyberCore WB-0038E.
// Only preinstalled, root-owned static wrapper units are startable by cybercore-exec.
// The bootstrap manifest reloads systemd before this policy is installed so these
// unit names cannot be claimed with StartTransientUnit.
polkit.addRule(function(action, subject) {
    if (subject.user !== "cybercore-exec") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (verb !== "start") {
        return polkit.Result.NOT_HANDLED;
    }
    if (
        unit === "cybercore-vikunja-backup-install.service" ||
        unit === "cybercore-vikunja-backup-run.service"
    ) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
