#!/usr/bin/python3
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import textwrap
import time


BACKUP_SCRIPT = Path("/usr/local/sbin/vikunja-backup")
SERVICE = Path("/etc/systemd/system/vikunja-backup.service")
TIMER = Path("/etc/systemd/system/vikunja-backup.timer")
SERVICE_TEMPLATE = Path("/usr/local/libexec/cybercore-exec/vikunja-backup.service.template")
TIMER_TEMPLATE = Path("/usr/local/libexec/cybercore-exec/vikunja-backup.timer.template")
BACKUP_ROOT = Path("/opt/backups/vikunja")
MANUAL_RUN_UNIT = "cybercore-vikunja-backup-run.service"
BACKUP_SERVICE_UNIT = "vikunja-backup.service"
BACKUP_TIMER_UNIT = "vikunja-backup.timer"
QUIESCE_TIMEOUT_SECONDS = 90.0
QUIESCE_POLL_SECONDS = 0.5


BACKUP_SCRIPT_TEXT = r'''#!/usr/bin/python3
from __future__ import annotations

from datetime import datetime, timedelta, timezone
import fcntl
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import tarfile


APP_ROOT = Path("/opt/vikunja")
BACKUP_ROOT = Path("/opt/backups/vikunja")
LOCK_PATH = Path("/run/cybercore-vikunja-backup/backup.lock")
RETENTION_DAYS = 14


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def run(argv: list[str], *, stdout_path: Path | None = None) -> None:
    if stdout_path is None:
        completed = subprocess.run(argv, check=False, shell=False)
        if completed.returncode != 0:
            raise SystemExit(completed.returncode)
        return
    with stdout_path.open("wb") as handle:
        completed = subprocess.run(argv, check=False, shell=False, stdout=handle)
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def acquire_backup_lock():
    fd = os.open(
        LOCK_PATH,
        os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    os.fchmod(fd, 0o600)
    handle = os.fdopen(fd, "r+")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def main() -> int:
    lock_handle = acquire_backup_lock()
    env = read_env(APP_ROOT / ".env")
    db_user = env.get("POSTGRES_USER", "vikunja")
    db_name = env.get("POSTGRES_DB", "vikunja")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    dest = BACKUP_ROOT / stamp
    dest.mkdir(parents=True, mode=0o700, exist_ok=False)

    db_dump = dest / "vikunja-db.dump"
    run(
        [
            "/usr/bin/docker",
            "compose",
            "-f",
            str(APP_ROOT / "docker-compose.yml"),
            "exec",
            "-T",
            "db",
            "pg_dump",
            "-Fc",
            "-U",
            db_user,
            db_name,
        ],
        stdout_path=db_dump,
    )
    db_dump.chmod(0o600)

    archive = dest / "vikunja-files-config.tar.gz"
    with tarfile.open(archive, "w:gz") as tar:
        for path in (
            APP_ROOT / "files",
            APP_ROOT / "docker-compose.yml",
            APP_ROOT / ".env",
        ):
            tar.add(path, arcname=path.relative_to(APP_ROOT.parent))
    archive.chmod(0o600)

    checksums = dest / "SHA256SUMS"
    checksums.write_text(
        f"{sha256(db_dump)}  {db_dump.name}\n{sha256(archive)}  {archive.name}\n"
    )
    checksums.chmod(0o600)

    cutoff = datetime.now(timezone.utc) - timedelta(days=RETENTION_DAYS)
    for child in BACKUP_ROOT.iterdir():
        if child == dest or not child.is_dir():
            continue
        try:
            created = datetime.strptime(child.name, "%Y%m%d-%H%M%S").replace(tzinfo=timezone.utc)
        except ValueError:
            continue
        if created < cutoff:
            shutil.rmtree(child)
    lock_handle.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
'''


def write_exact(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(textwrap.dedent(content))
    os.chmod(path, mode)


def systemctl(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["/usr/bin/systemctl", *args],
        check=False,
        shell=False,
        text=True,
        capture_output=True,
    )


def require_systemctl(*args: str) -> None:
    completed = systemctl(*args)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "systemctl failed"
        raise RuntimeError(f"{' '.join(args)}: {detail}")


def unit_is_active(unit: str) -> bool:
    completed = systemctl("is-active", "--quiet", unit)
    if completed.returncode == 0:
        return True
    if completed.returncode in {3, 4}:
        return False
    detail = completed.stderr.strip() or completed.stdout.strip() or "systemctl is-active failed"
    raise RuntimeError(f"{unit}: {detail}")


def unit_has_pending_job(unit: str) -> bool:
    completed = systemctl("list-jobs", "--no-legend", "--plain", unit)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "systemctl list-jobs failed"
        raise RuntimeError(f"{unit}: {detail}")
    return bool(completed.stdout.strip())


def wait_until_quiescent(unit: str, deadline: float) -> None:
    while True:
        if not unit_has_pending_job(unit) and not unit_is_active(unit):
            return
        if time.monotonic() >= deadline:
            raise RuntimeError(f"timed out waiting for {unit} to become quiescent")
        time.sleep(QUIESCE_POLL_SECONDS)


def quiesce_backup_entry_paths() -> None:
    require_systemctl("mask", "--runtime", MANUAL_RUN_UNIT)
    if unit_is_active(BACKUP_TIMER_UNIT):
        require_systemctl("stop", BACKUP_TIMER_UNIT)

    deadline = time.monotonic() + QUIESCE_TIMEOUT_SECONDS
    wait_until_quiescent(MANUAL_RUN_UNIT, deadline)
    wait_until_quiescent(BACKUP_TIMER_UNIT, deadline)
    wait_until_quiescent(BACKUP_SERVICE_UNIT, deadline)


def main() -> int:
    quiesce_backup_entry_paths()
    BACKUP_ROOT.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(BACKUP_ROOT, 0o700)
    write_exact(BACKUP_SCRIPT, BACKUP_SCRIPT_TEXT, 0o700)
    write_exact(SERVICE, SERVICE_TEMPLATE.read_text(), 0o644)
    write_exact(TIMER, TIMER_TEMPLATE.read_text(), 0o644)

    require_systemctl("daemon-reload")
    require_systemctl("unmask", "--runtime", MANUAL_RUN_UNIT)
    require_systemctl("enable", "--now", BACKUP_TIMER_UNIT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
